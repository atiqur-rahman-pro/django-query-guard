# ==============================================================================
# django-query-guard: GitHub Actions CI/CD Workflow
#
# Author: Atiqur Rahman
# Role: Software QA Engineer | SDET | Test Automation Architect
# GitHub: https://github.com/atiqur-rahman-pro
# License: MIT License
#
# USAGE: Copy this file to your Django project's .github/workflows/ directory.
# It will automatically run django-query-guard on every Pull Request.
# ==============================================================================

name: django-query-guard CI

on:
  push:
    branches: [main, develop]
  pull_request:
    branches: [main, develop]

jobs:
  query-guard:
    name: 🛡️ N+1 Query Detection
    runs-on: ubuntu-latest

    strategy:
      matrix:
        python-version: ["3.10", "3.11", "3.12", "3.13"]

    steps:
      # ================================================================
      # STEP 1: CHECKOUT REPOSITORY
      # ================================================================
      - name: 📥 Checkout Repository
        uses: actions/checkout@v4

      # ================================================================
      # STEP 2: SETUP PYTHON ENVIRONMENT
      # ================================================================
      - name: 🐍 Setup Python ${{ matrix.python-version }}
        uses: actions/setup-python@v5
        with:
          python-version: ${{ matrix.python-version }}

      # ================================================================
      # STEP 3: INSTALL DEPENDENCIES
      # ================================================================
      - name: 📦 Install Dependencies
        run: |
          python -m pip install --upgrade pip
          pip install django-query-guard
          pip install -r requirements.txt || pip install django pytest pytest-django

      # ================================================================
      # STEP 4: RUN PYTEST WITH QUERY GUARD REPORT & TREND TRACKING
      # ================================================================
      - name: 🛡️ Run Query Guard Tests
        run: |
          pytest \
            --query-guard-report=query_guard_report.html \
            --query-guard-trend=.query_guard_history.json \
            -v

      # ================================================================
      # STEP 5: UPLOAD HTML REPORT AS ARTIFACT
      # ================================================================
      - name: 📊 Upload Query Guard Report
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: query-guard-report-py${{ matrix.python-version }}
          path: query_guard_report.html
          retention-days: 30

      # ================================================================
      # STEP 6: UPLOAD TREND HISTORY FOR FUTURE COMPARISONS
      # ================================================================
      - name: 📈 Upload Trend History
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: query-guard-trend-py${{ matrix.python-version }}
          path: .query_guard_history.json
          retention-days: 90
